          </parameter>
          <parameter type="Text" name="IdMeas" desc="IdMeas" group="" helpmode="Append" allowemptystr="false">
            <value>Id_kA</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="IqMeas" desc="IqMeas" group="" helpmode="Append" allowemptystr="false">
            <value>Iq_kA</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="IdRef" desc="IdRef" group="" helpmode="Append" allowemptystr="false">
            <value>Id_ref_kA</value>
            <cond type="Enable" />
