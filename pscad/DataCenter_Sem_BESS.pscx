          </parameter>
          <parameter type="Text" name="GBH" desc="GBH" group="" helpmode="Append" allowemptystr="false">
            <value>Gate_BH</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="GBL" desc="GBL" group="" helpmode="Append" allowemptystr="false">
            <value>Gate_BL</value>
            <cond type="Enable" />
