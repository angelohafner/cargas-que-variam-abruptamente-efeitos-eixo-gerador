            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Vq" desc="Vq" group="" helpmode="Append" allowemptystr="false">
            <value>Vq_kV</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Carrier" desc="Carrier" group="" helpmode="Append" allowemptystr="false">
            <value>Carrier</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Enable" desc="Enable" group="" helpmode="Append" allowemptystr="false">
            <value>BESS_ramp</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">DATA CENTER CONTROL</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">Load | Smoothing | SOC | PLL | dq | PWM</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190010002" classid="CoreSegment"><![CDATA[#LOCAL REAL OUTX0
#LOCAL REAL OUTX1
#LOCAL REAL OUTX2
#LOCAL REAL OUTX3
#LOCAL REAL OUTX4
#LOCAL REAL OUTX5
#LOCAL REAL OUTX6
#LOCAL REAL OUTX7
#LOCAL REAL OUTX8
#LOCAL REAL OUTX9
#LOCAL REAL OUTX10
#LOCAL REAL OUTX11
#LOCAL REAL OUTX12
#LOCAL REAL OUTX13
#LOCAL REAL OUTX14
#LOCAL REAL OUTX15
#LOCAL REAL OUTX16
#LOCAL REAL OUTX17
#LOCAL REAL OUTX18
#LOCAL REAL OUTX19
#LOCAL REAL OUTX20
#LOCAL REAL OUTX21
#LOCAL REAL OUTX22
#LOCAL REAL OUTX23
#LOCAL REAL OUTX24
#LOCAL REAL OUTX25
#LOCAL REAL OUTX26
#LOCAL REAL OUTX27
#LOCAL REAL OUTX28
#STORAGE REAL:20
#LOCAL INTEGER K
#LOCAL REAL PI
#LOCAL REAL W
#LOCAL REAL TARGET
#LOCAL REAL DV
#LOCAL REAL REC
#LOCAL REAL REF
#LOCAL REAL RAW
#LOCAL REAL PCMD
#LOCAL REAL AL
#LOCAL REAL BE
#LOCAL REAL VM
#LOCAL REAL TH
#LOCAL REAL VD
#LOCAL REAL VQ
#LOCAL REAL IA
#LOCAL REAL IB
#LOCAL REAL ID
#LOCAL REAL IQ
#LOCAL REAL IDR
#LOCAL REAL IQR
#LOCAL REAL ED
#LOCAL REAL EQ
#LOCAL REAL UD
#LOCAL REAL UQ
#LOCAL REAL UA
#LOCAL REAL UB
#LOCAL REAL UC
#LOCAL REAL MODMAX
#LOCAL REAL FAC
#LOCAL REAL CAR
#LOCAL REAL EN
#LOCAL REAL XP
#LOCAL REAL XQ
#LOCAL REAL EP
#LOCAL REAL EQP
#LOCAL REAL UDL
#LOCAL REAL UQL
#LOCAL REAL ANG
      K=NSTORF
      NSTORF=NSTORF+20
      PI=3.141592653589793
      W=2.0*PI*$Fgrid
      IF (TIME.LT.DELT*0.5) THEN
        STORF(K:K+19)=0.0
        STORF(K)=$Pmin
        STORF(K+1)=$Pmin
        STORF(K+2)=$Pmin
      ENDIF
! Physical load demand, same in both cases. States: load, LPF, ramp.
      TARGET=$Pmin
      IF(TIME.GE.$T1.AND.TIME.LT.$T2) TARGET=$Pstep1
      IF(TIME.GE.$T2.AND.TIME.LT.$T3) TARGET=$Pstep2
      IF(TIME.GE.$T3.AND.TIME.LT.$T4) THEN
        IF(MODULO(TIME-$T3,$Period1).LT.$Period1*$Duty1) TARGET=$Pmax
      ENDIF
      IF(TIME.GE.$T4.AND.TIME.LT.$T5) TARGET=$Pmax
      IF(TIME.GE.$T6.AND.TIME.LT.$T7) THEN
        IF(MODULO(TIME-$T6,$Period2).LT.$Period2*$Duty2) TARGET=$Pmax
      ENDIF
      IF(TIME.GE.$T7) TARGET=$Pmid
      IF($ExperimentModeIn.GT.0.5) TARGET=$ExperimentDemand
      DV=($Pmax-$Pmin)*DELT/MAX($Transition,DELT)
      STORF(K)=STORF(K)+MAX(-DV,MIN(DV,TARGET-STORF(K)))
      OUTX0=STORF(K)
      OUTX1=STORF(K)/3.0
      STORF(K+1)=STORF(K+1)+DELT/MAX($TauSmooth,DELT)*($LoadMeasured-STORF(K+1))
      REC=0.0
      IF(ABS($SOCref-$SOCMeasured).GT.$RecoveryDead) THEN
        REC=MAX(-$RecoveryMax,MIN($RecoveryMax,$RecoveryGain*($SOCref-$SOCMeasured)))
      ENDIF
      STORF(K+3)=STORF(K+3)+DELT/MAX($RecoveryTau,DELT)*(REC-STORF(K+3))
      REF=STORF(K+1)+STORF(K+3)
      DV=$RampMax*DELT
      STORF(K+2)=STORF(K+2)+MAX(-DV,MIN(DV,REF-STORF(K+2)))
      IF(TIME.LT.0.5) THEN
        STORF(K+1)=$Pmin
        STORF(K+2)=$Pmin
      ENDIF
      OUTX2=STORF(K+2)
      OUTX5=STORF(K+3)
      RAW=$LoadMeasured-OUTX2
      IF($TestMode.GT.0.5.AND.TIME.GT.0.8) THEN
        IF($TestMode.LT.1.5) RAW=$TestPower
        IF($TestMode.GE.1.5.AND.$TestMode.LT.2.5) RAW=-$TestPower
        IF($TestMode.GE.2.5) RAW=$TestPower
        IF(TIME.GT.3.0) RAW=-RAW
      ENDIF
      OUTX3=RAW
      PCMD=MAX(-$PmaxBess,MIN($PmaxBess,RAW))
      OUTX7=0.0
      IF(ABS(RAW-PCMD).GT.0.0001) OUTX7=1.0
! Predictive guard band .002 percentage points covers controller current decay.
      IF($SOCMeasured.LE.$SOCmin+0.002) STORF(K+4)=1.0
      IF($SOCMeasured.GE.$SOCmin+$SOChyst) STORF(K+4)=0.0
      IF($SOCMeasured.GE.$SOCmax-0.002) STORF(K+5)=1.0
      IF($SOCMeasured.LE.$SOCmax-$SOChyst) STORF(K+5)=0.0
      OUTX6=0.0
      IF(STORF(K+4).GT.0.5.AND.PCMD.GT.-0.02*$PmaxBess) THEN
! Small permitted charging bias supplies VSC idle losses at the lower limit.
        PCMD=-0.02*$PmaxBess
        OUTX6=1.0
      ENDIF
      IF(STORF(K+5).GT.0.5.AND.PCMD.LT.0.02*$PmaxBess) THEN
        PCMD=0.02*$PmaxBess
        OUTX6=-1.0
      ENDIF
      EN=MAX(0.0,MIN(1.0,(TIME-0.5)/0.1))*$BessEnabled
      OUTX4=PCMD*EN
      OUTX28=EN
      OUTX19=1.0
      IF(TIME.GT.0.15) OUTX19=0.0
! SRF PLL, amplitude invariant Clarke/Park. Voltage kV, current kA.
      AL=(2.0*$Va-$Vb-$Vc)/3.0
      BE=($Vb-$Vc)/SQRT(3.0)
      VM=MAX(0.1,SQRT(AL*AL+BE*BE))
      TH=STORF(K+6)
      IF(TIME.LT.0.2) TH=ATAN2(BE,AL)
      VD=AL*COS(TH)+BE*SIN(TH)
      VQ=-AL*SIN(TH)+BE*COS(TH)
      EP=MAX(-1.0,MIN(1.0,VQ/VM))
      STORF(K+7)=MAX(-20.0,MIN(20.0,STORF(K+7)+$KiPLL*EP*DELT))
      ANG=W+$KpPLL*EP+STORF(K+7)
      STORF(K+6)=MODULO(TH+ANG*DELT,2.0*PI)
      OUTX20=TH
      OUTX21=ANG/(2.0*PI)
      OUTX25=VD
      OUTX26=VQ
      IA=(2.0*$Ia-$Ib-$Ic)/3.0
      IB=($Ib-$Ic)/SQRT(3.0)
      ID=IA*COS(TH)+IB*SIN(TH)
      IQ=-IA*SIN(TH)+IB*COS(TH)
      STORF(K+8)=STORF(K+8)+DELT/(0.0001+DELT)*(ID-STORF(K+8))
      STORF(K+9)=STORF(K+9)+DELT/(0.0001+DELT)*(IQ-STORF(K+9))
      ID=STORF(K+8)
      IQ=STORF(K+9)
      IDR=OUTX4/(1.5*MAX(0.35,VD))
      OUTX8=0.0
      IF(ABS(IDR).GT.$Imax) OUTX8=1.0
      IDR=MAX(-$Imax,MIN($Imax,IDR))
      IQR=0.0
      OUTX22=ID
      OUTX23=IQ
      OUTX24=IDR
      ED=IDR-ID
      EQ=IQR-IQ
      XP=STORF(K+10)
      XQ=STORF(K+11)
      UD=VD+$Rf*ID-W*$Lf*IQ+$KpI*ED+XP
      UQ=VQ+$Rf*IQ+W*$Lf*ID+$KpI*EQ+XQ
      UA=2.0*(UD*COS(TH)-UQ*SIN(TH))/MAX(0.3,$VdcMeasured)
      UB=2.0*(UD*COS(TH-2.0*PI/3.0)-UQ*SIN(TH-2.0*PI/3.0))/MAX(0.3,$VdcMeasured)
      UC=2.0*(UD*COS(TH+2.0*PI/3.0)-UQ*SIN(TH+2.0*PI/3.0))/MAX(0.3,$VdcMeasured)
      MODMAX=MAX(ABS(UA),ABS(UB),ABS(UC))
      FAC=MIN(1.0,$Mmax/MAX(0.0001,MODMAX))
      OUTX9=0.0
      IF(FAC.LT.0.9999) OUTX9=1.0
! Back-calculation anti-windup on voltage-vector saturation.
      STORF(K+10)=MAX(-0.4,MIN(0.4,XP+DELT*($KiI*ED+100.0*(FAC-1.0)*UD)))
      STORF(K+11)=MAX(-0.4,MIN(0.4,XQ+DELT*($KiI*EQ+100.0*(FAC-1.0)*UQ)))
      IF(TIME.LT.0.2) THEN
        STORF(K+10)=0.0
        STORF(K+11)=0.0
      ENDIF
      OUTX10=UA*FAC
      OUTX11=UB*FAC
      OUTX12=UC*FAC
      CAR=1.0-4.0*ABS(MODULO(TIME*$Fsw,1.0)-0.5)
      OUTX27=CAR
      OUTX13=0.0
      OUTX14=0.0
      OUTX15=0.0
      OUTX16=0.0
      OUTX17=0.0
      OUTX18=0.0
      IF(TIME.GT.0.2.AND.$BessEnabled.GT.0.5) THEN
        IF(OUTX10.GE.CAR) OUTX13=1.0
        IF(OUTX10.LT.CAR) OUTX14=1.0
        IF(OUTX11.GE.CAR) OUTX15=1.0
        IF(OUTX11.LT.CAR) OUTX16=1.0
        IF(OUTX12.GE.CAR) OUTX17=1.0
        IF(OUTX12.LT.CAR) OUTX18=1.0
      ENDIF
#OUTPUT REAL Pcommand {OUTX0}
#OUTPUT REAL LoadScale {OUTX1}
#OUTPUT REAL GridRef {OUTX2}
#OUTPUT REAL BessRaw {OUTX3}
#OUTPUT REAL BessRef {OUTX4}
#OUTPUT REAL Recovery {OUTX5}
#OUTPUT REAL SOCblock {OUTX6}
#OUTPUT REAL PowerLimit {OUTX7}
#OUTPUT REAL CurrentLimit {OUTX8}
#OUTPUT REAL ModLimit {OUTX9}
#OUTPUT REAL ModA {OUTX10}
#OUTPUT REAL ModB {OUTX11}
#OUTPUT REAL ModC {OUTX12}
#OUTPUT REAL GAH {OUTX13}
#OUTPUT REAL GAL {OUTX14}
#OUTPUT REAL GBH {OUTX15}
#OUTPUT REAL GBL {OUTX16}
#OUTPUT REAL GCH {OUTX17}
#OUTPUT REAL GCL {OUTX18}
#OUTPUT REAL Precharge {OUTX19}
#OUTPUT REAL Theta {OUTX20}
#OUTPUT REAL Frequency {OUTX21}
#OUTPUT REAL IdMeas {OUTX22}
#OUTPUT REAL IqMeas {OUTX23}
#OUTPUT REAL IdRef {OUTX24}
#OUTPUT REAL Vd {OUTX25}
#OUTPUT REAL Vq {OUTX26}
#OUTPUT REAL Carrier {OUTX27}
#OUTPUT REAL Enable {OUTX28}
]]></segment>
      </script>
      <graphics>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
        <Gfx classid="Graphics.Rectangle" id="1517650836" x="-180" y="-54" w="360" h="108">
          <paramlist>
            <param name="color" value="Black" />
            <param name="dasharray" value="0" />
            <param name="thickness" value="0" />
            <param name="port" value="" />
            <param name="fill_style" value="1" />
            <param name="fill_fg" value="#e1f0f4" />
            <param name="fill_bg" value="White" />
            <param name="cond" value="true" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1788557663" x="0" y="-12">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="DATA CENTER CONTROL" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="955557107" x="0" y="15">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="Load | Smoothing | SOC | PLL | dq | PWM" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
      </graphics>
    </Definition>
    <Definition classid="UserCmpDefn" name="GeneratorAVR" url="" view="false" instances="0" date="0" crc="67097334" id="190040001">
      <paramlist>
        <param name="Description" value="Voltage PI | Field limits | Initialization tracking" />
      </paramlist>
      <form name="GENERATOR AVR" w="650" h="750" splitter="60" commentlines="4">
        <category name="Adjustable parameters" visible="true">
          <cond />
          <parameter type="Real" name="Vref" desc="Generator terminal voltage reference [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Kp" desc="Voltage proportional gain" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>8.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Ki" desc="Voltage integral gain [1/s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>12.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Te" desc="Field response lag [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.03</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Emin" desc="Minimum field voltage [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Emax" desc="Maximum field voltage [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Start" desc="Source to machine transition [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.3</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Measured inputs" visible="true">
          <cond />
          <parameter type="Real" name="Vt" desc="Vt" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Generator_Vt_pu</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Einit" desc="Einit" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Generator_Ef0_pu</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Named outputs" visible="true">
          <cond />
          <parameter type="Text" name="Ef" desc="Ef" group="" helpmode="Append" allowemptystr="false">
            <value>Generator_Ef_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Limit" desc="Limit" group="" helpmode="Append" allowemptystr="false">
            <value>AVR_limit</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">GENERATOR AVR</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">Voltage PI | Field limits | Initialization tracking</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190040002" classid="CoreSegment"><![CDATA[#LOCAL REAL GX0
#LOCAL REAL GX1
#STORAGE REAL:2
#LOCAL INTEGER K
#LOCAL REAL ERR
#LOCAL REAL RAW
#LOCAL REAL CMD
      K=NSTORF
      NSTORF=NSTORF+2
      ERR=$Vref-$Vt
      IF(TIME.LT.$Start) THEN
        STORF(K)=$Einit-$Kp*ERR
        STORF(K+1)=$Einit
      ELSE
        RAW=STORF(K)+$Kp*ERR
        CMD=MAX($Emin,MIN($Emax,RAW))
        STORF(K)=STORF(K)+DELT*($Ki*ERR+10.0*(CMD-RAW))
        STORF(K+1)=STORF(K+1)+DELT/MAX($Te,DELT)*(CMD-STORF(K+1))
      ENDIF
      GX0=MAX($Emin,MIN($Emax,STORF(K+1)))
      GX1=0.0
      IF(GX0.GE.$Emax-0.0001.OR.GX0.LE.$Emin+0.0001) GX1=1.0
#OUTPUT REAL Ef {GX0}
#OUTPUT REAL Limit {GX1}
]]></segment>
      </script>
      <graphics>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
        <Gfx classid="Graphics.Rectangle" id="669183100" x="-180" y="-54" w="360" h="108">
          <paramlist>
            <param name="color" value="Black" />
            <param name="dasharray" value="0" />
            <param name="thickness" value="0" />
            <param name="port" value="" />
            <param name="fill_style" value="1" />
            <param name="fill_fg" value="#e1f0f4" />
            <param name="fill_bg" value="White" />
            <param name="cond" value="true" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="216241506" x="0" y="-12">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="GENERATOR AVR" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1722013835" x="0" y="15">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="Voltage PI | Field limits | Initialization tracking" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
      </graphics>
    </Definition>
    <Definition classid="UserCmpDefn" name="TorsionExperiment" url="" view="false" instances="0" date="0" crc="100447495" id="190050001">
      <paramlist>
        <param name="Description" value="0 profile | 1 constant | 2 pulse | 3 chirp | 4 sine" />
      </paramlist>
      <form name="TORSIONAL LOAD EXPERIMENT" w="650" h="750" splitter="60" commentlines="4">
        <category name="Adjustable parameters" visible="true">
          <cond />
          <parameter type="Real" name="Mode" desc="0 original load profile; 1 constant; 2 pulse-ringdown; 3 chirp; 4 sine" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pbase" desc="Mean load [MW]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>4.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Amplitude" desc="Load perturbation [MW]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Start" desc="Perturbation start [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Duration" desc="Chirp/sine duration [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="PulseWidth" desc="Load pulse width [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.025</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fstart" desc="Chirp initial frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fend" desc="Chirp final frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>30.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fsine" desc="Single sine frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>10.61087357</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Tmachine" desc="Source to machine switch [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.3</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Trelease" desc="Rotor release [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.2</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Measured inputs" visible="true">
          <cond />
        </category>
        <category name="Named outputs" visible="true">
          <cond />
          <parameter type="Text" name="Demand" desc="Demand" group="" helpmode="Append" allowemptystr="false">
            <value>P_experiment_MW</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="ModeOut" desc="ModeOut" group="" helpmode="Append" allowemptystr="false">
            <value>ExcitationMode</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Fexc" desc="Fexc" group="" helpmode="Append" allowemptystr="false">
            <value>Excitation_Hz</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Machine" desc="Machine" group="" helpmode="Append" allowemptystr="false">
            <value>Machine_enabled</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Release" desc="Release" group="" helpmode="Append" allowemptystr="false">
            <value>Rotor_released</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">TORSIONAL LOAD EXPERIMENT</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">0 profile | 1 constant | 2 pulse | 3 chirp | 4 sine</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190050002" classid="CoreSegment"><![CDATA[#LOCAL REAL GX0
#LOCAL REAL GX1
#LOCAL REAL GX2
#LOCAL REAL GX3
#LOCAL REAL GX4
#LOCAL REAL T
#LOCAL REAL D
#LOCAL REAL PH
#LOCAL REAL E
      T=TIME-$Start
      D=0.0
      GX2=0.0
      IF($Mode.GT.1.5.AND.$Mode.LT.2.5) THEN
        IF(T.GE.0.0.AND.T.LT.$PulseWidth) D=$Amplitude
      ENDIF
      IF($Mode.GT.2.5.AND.$Mode.LT.3.5) THEN
        IF(T.GE.0.0.AND.T.LT.$Duration) THEN
          PH=6.283185307179586*($Fstart*T+0.5*($Fend-$Fstart)*T*T/MAX($Duration,0.001))
          E=MIN(1.0,MIN(T,MAX(0.0,$Duration-T))/0.10)
          D=$Amplitude*E*SIN(PH)
          GX2=$Fstart+($Fend-$Fstart)*T/MAX($Duration,0.001)
        ENDIF
      ENDIF
      IF($Mode.GT.3.5) THEN
        IF(T.GE.0.0.AND.T.LT.$Duration) THEN
          E=MIN(1.0,MIN(T,MAX(0.0,$Duration-T))/0.10)
          D=$Amplitude*E*SIN(6.283185307179586*$Fsine*T)
          GX2=$Fsine
        ENDIF
      ENDIF
      GX0=MAX(0.1,$Pbase+D)
      GX1=$Mode
      GX3=0.0
      GX4=0.0
      IF(TIME.GE.$Tmachine) GX3=1.0
      IF(TIME.GE.$Trelease) GX4=1.0
#OUTPUT REAL Demand {GX0}
#OUTPUT REAL ModeOut {GX1}
#OUTPUT REAL Fexc {GX2}
#OUTPUT REAL Machine {GX3}
#OUTPUT REAL Release {GX4}
]]></segment>
      </script>
