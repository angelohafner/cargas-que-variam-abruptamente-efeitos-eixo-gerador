            <param name="cond" value="true" />
            <param name="text" value="GAS TURBINE - GAST" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="778537038" x="0" y="15">
