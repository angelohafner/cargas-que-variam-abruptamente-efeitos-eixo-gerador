    <Definition classid="UserCmpDefn" name="GasTurbineGAST" url="" view="false" instances="0" date="0" crc="83863694" id="190030001">
      <paramlist>
        <param name="Description" value="Fuel valve | Turbine | Temperature limit | Speed governor" />
      </paramlist>
      <form name="GAS TURBINE - GAST" w="650" h="750" splitter="60" commentlines="4">
        <category name="Adjustable parameters" visible="true">
          <cond />
          <parameter type="Real" name="R" desc="Speed droop [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.05</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T1" desc="Fuel valve time constant [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.15</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T2" desc="Turbine power time constant [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.3</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T3" desc="Exhaust-temperature surrogate lag [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>3.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="AT" desc="Ambient-temperature power limit [pu on machine MVA]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.8</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KT" desc="Temperature limiter gain" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Vmax" desc="Maximum fuel valve [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Vmin" desc="Minimum fuel valve [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.02</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Rate" desc="Valve movement rate [pu/s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KiSpeed" desc="Secondary frequency integral gain [1/s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Dturb" desc="Turbine speed damping [pu]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fbase" desc="Electrical frequency base [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>60.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RPM" desc="Mechanical shaft base speed [rpm]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>3600.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Release" desc="Rotor release time [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.2</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Measured inputs" visible="true">
          <cond />
          <parameter type="Real" name="Speed" desc="Speed" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Shaft_speed_rad_s</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Mass1Deviation" desc="Mass1Deviation" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Shaft_dw1_rad_s</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Tinit" desc="Tinit" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>MM_Tm0_pu</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Named outputs" visible="true">
          <cond />
          <parameter type="Text" name="Tm" desc="Tm" group="" helpmode="Append" allowemptystr="false">
            <value>Gas_Tm_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Pgas" desc="Pgas" group="" helpmode="Append" allowemptystr="false">
            <value>Gas_power_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Fuel" desc="Fuel" group="" helpmode="Append" allowemptystr="false">
            <value>Fuel_valve_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Temp" desc="Temp" group="" helpmode="Append" allowemptystr="false">
            <value>Exhaust_surrogate_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Limit" desc="Limit" group="" helpmode="Append" allowemptystr="false">
            <value>Gas_limit</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Freq" desc="Freq" group="" helpmode="Append" allowemptystr="false">
            <value>Generator_Hz</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Pref" desc="Pref" group="" helpmode="Append" allowemptystr="false">
            <value>Gas_reference_pu</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">GAS TURBINE - GAST</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">Fuel valve | Turbine | Temperature limit | Speed governor</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190030002" classid="CoreSegment"><![CDATA[#LOCAL REAL GX0
#LOCAL REAL GX1
#LOCAL REAL GX2
#LOCAL REAL GX3
#LOCAL REAL GX4
#LOCAL REAL GX5
#LOCAL REAL GX6
#STORAGE REAL:4
#LOCAL INTEGER K
#LOCAL REAL WPU
#LOCAL REAL WMPU
#LOCAL REAL ERR
#LOCAL REAL REF
#LOCAL REAL THL
#LOCAL REAL CMD
#LOCAL REAL DVAL
#LOCAL REAL POW
      K=NSTORF
      NSTORF=NSTORF+4
      WPU=$Speed/(6.283185307179586*$Fbase)
      WMPU=1.0+$Mass1Deviation/(6.283185307179586*$RPM/60.0)
      ERR=1.0-WPU
      IF(TIME.LT.$Release) THEN
        STORF(K)=MAX($Vmin,MIN($Vmax,$Tinit))
        STORF(K+1)=STORF(K)
        STORF(K+2)=STORF(K)
        STORF(K+3)=STORF(K)
      ELSE
        STORF(K+3)=MAX($Vmin,MIN($AT,STORF(K+3)+$KiSpeed*ERR*DELT))
        REF=STORF(K+3)+ERR/MAX($R,0.001)
        THL=$AT+$KT*($AT-STORF(K+2))
        CMD=MAX($Vmin,MIN($Vmax,MIN(REF,THL)))
        DVAL=(CMD-STORF(K))/MAX($T1,DELT)
        STORF(K)=STORF(K)+DELT*MAX(-$Rate,MIN($Rate,DVAL))
        STORF(K+1)=STORF(K+1)+DELT/MAX($T2,DELT)*(STORF(K)-STORF(K+1))
        STORF(K+2)=STORF(K+2)+DELT/MAX($T3,DELT)*(STORF(K+1)-STORF(K+2))
      ENDIF
      POW=STORF(K+1)-$Dturb*(WPU-1.0)
      GX0=POW/MAX(0.5,WMPU)
      GX1=POW
      GX2=STORF(K)
      GX3=STORF(K+2)
      GX6=STORF(K+3)
      GX4=0.0
      IF(STORF(K).GE.$Vmax-0.0001) GX4=1.0
      IF(STORF(K+2).GE.$AT) GX4=1.0
      GX5=WPU*$Fbase
#OUTPUT REAL Tm {GX0}
#OUTPUT REAL Pgas {GX1}
#OUTPUT REAL Fuel {GX2}
#OUTPUT REAL Temp {GX3}
#OUTPUT REAL Limit {GX4}
#OUTPUT REAL Freq {GX5}
#OUTPUT REAL Pref {GX6}
]]></segment>
      </script>
      <graphics>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
