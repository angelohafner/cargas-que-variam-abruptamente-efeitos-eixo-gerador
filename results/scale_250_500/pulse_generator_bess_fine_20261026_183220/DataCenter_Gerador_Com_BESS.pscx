            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Limit" desc="Limit" group="" helpmode="Append" allowemptystr="false">
            <value>AVR_limit</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">GENERATOR AVR</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">Voltage PI | Field limits | Initialization tracking</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190040002" classid="CoreSegment"><![CDATA[#LOCAL REAL GX0
#LOCAL REAL GX1
#STORAGE REAL:2
#LOCAL INTEGER K
#LOCAL REAL ERR
#LOCAL REAL RAW
#LOCAL REAL CMD
      K=NSTORF
      NSTORF=NSTORF+2
      ERR=$Vref-$Vt
      IF(TIME.LT.$Start) THEN
        STORF(K)=$Einit-$Kp*ERR
        STORF(K+1)=$Einit
      ELSE
        RAW=STORF(K)+$Kp*ERR
        CMD=MAX($Emin,MIN($Emax,RAW))
        STORF(K)=STORF(K)+DELT*($Ki*ERR+10.0*(CMD-RAW))
        STORF(K+1)=STORF(K+1)+DELT/MAX($Te,DELT)*(CMD-STORF(K+1))
      ENDIF
      GX0=MAX($Emin,MIN($Emax,STORF(K+1)))
      GX1=0.0
      IF(GX0.GE.$Emax-0.0001.OR.GX0.LE.$Emin+0.0001) GX1=1.0
#OUTPUT REAL Ef {GX0}
#OUTPUT REAL Limit {GX1}
]]></segment>
      </script>
      <graphics>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
        <Gfx classid="Graphics.Rectangle" id="2144299625" x="-180" y="-54" w="360" h="108">
