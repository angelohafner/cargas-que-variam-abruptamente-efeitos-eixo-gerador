    <Definition classid="UserCmpDefn" name="TorsionExperiment" url="" view="false" instances="0" date="0" crc="20686407" id="190050001">
      <paramlist>
        <param name="Description" value="0 profile | 1 constant | 2 pulse | 3 chirp | 4 sine" />
      </paramlist>
      <form name="TORSIONAL LOAD EXPERIMENT" w="650" h="750" splitter="60" commentlines="4">
        <category name="Adjustable parameters" visible="true">
          <cond />
          <parameter type="Real" name="Mode" desc="0 original load profile; 1 constant; 2 pulse-ringdown; 3 chirp; 4 sine" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pbase" desc="Mean load [MW]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>4.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Amplitude" desc="Load perturbation [MW]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Start" desc="Perturbation start [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Duration" desc="Chirp/sine duration [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="PulseWidth" desc="Load pulse width [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.025</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fstart" desc="Chirp initial frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fend" desc="Chirp final frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>30.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fsine" desc="Single sine frequency [Hz]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>10.61087357</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Tmachine" desc="Source to machine switch [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.3</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Trelease" desc="Rotor release [s]" content_type="Constant" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.2</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Measured inputs" visible="true">
          <cond />
        </category>
        <category name="Named outputs" visible="true">
          <cond />
          <parameter type="Text" name="Demand" desc="Demand" group="" helpmode="Append" allowemptystr="false">
            <value>P_experiment_MW</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="ModeOut" desc="ModeOut" group="" helpmode="Append" allowemptystr="false">
            <value>ExcitationMode</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Fexc" desc="Fexc" group="" helpmode="Append" allowemptystr="false">
            <value>Excitation_Hz</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Machine" desc="Machine" group="" helpmode="Append" allowemptystr="false">
            <value>Machine_enabled</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter type="Text" name="Release" desc="Release" group="" helpmode="Append" allowemptystr="false">
            <value>Rotor_released</value>
            <cond type="Enable" />
            <help />
            <regex />
            <error_msg />
          </parameter>
        </category>
      </form>
      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">TORSIONAL LOAD EXPERIMENT</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">0 profile | 1 constant | 2 pulse | 3 chirp | 4 sine</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190050002" classid="CoreSegment"><![CDATA[#LOCAL REAL GX0
#LOCAL REAL GX1
#LOCAL REAL GX2
#LOCAL REAL GX3
#LOCAL REAL GX4
#LOCAL REAL T
#LOCAL REAL D
#LOCAL REAL PH
#LOCAL REAL E
      T=TIME-$Start
      D=0.0
      GX2=0.0
      IF($Mode.GT.1.5.AND.$Mode.LT.2.5) THEN
        IF(T.GE.0.0.AND.T.LT.$PulseWidth) D=$Amplitude
      ENDIF
      IF($Mode.GT.2.5.AND.$Mode.LT.3.5) THEN
        IF(T.GE.0.0.AND.T.LT.$Duration) THEN
          PH=6.283185307179586*($Fstart*T+0.5*($Fend-$Fstart)*T*T/MAX($Duration,0.001))
          E=MIN(1.0,MIN(T,MAX(0.0,$Duration-T))/0.10)
          D=$Amplitude*E*SIN(PH)
          GX2=$Fstart+($Fend-$Fstart)*T/MAX($Duration,0.001)
        ENDIF
      ENDIF
      IF($Mode.GT.3.5) THEN
        IF(T.GE.0.0.AND.T.LT.$Duration) THEN
          E=MIN(1.0,MIN(T,MAX(0.0,$Duration-T))/0.10)
          D=$Amplitude*E*SIN(6.283185307179586*$Fsine*T)
          GX2=$Fsine
        ENDIF
      ENDIF
      GX0=MAX(0.1,$Pbase+D)
      GX1=$Mode
      GX3=0.0
      GX4=0.0
      IF(TIME.GE.$Tmachine) GX3=1.0
      IF(TIME.GE.$Trelease) GX4=1.0
#OUTPUT REAL Demand {GX0}
#OUTPUT REAL ModeOut {GX1}
#OUTPUT REAL Fexc {GX2}
#OUTPUT REAL Machine {GX3}
#OUTPUT REAL Release {GX4}
]]></segment>
      </script>
      <graphics>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
        <Gfx classid="Graphics.Rectangle" id="1666798398" x="-180" y="-54" w="360" h="108">
          <paramlist>
            <param name="color" value="Black" />
            <param name="dasharray" value="0" />
            <param name="thickness" value="0" />
            <param name="port" value="" />
            <param name="fill_style" value="1" />
            <param name="fill_fg" value="#e1f0f4" />
            <param name="fill_bg" value="White" />
            <param name="cond" value="true" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="933228673" x="0" y="-12">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="TORSIONAL LOAD EXPERIMENT" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1900823072" x="0" y="15">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="0 profile | 1 constant | 2 pulse | 3 chirp | 4 sine" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
      </graphics>
    </Definition>
    <Definition classid="UserCmpDefn" name="GasTurbineGAST" url="" view="false" instances="0" date="0" crc="57120265" id="190030001">
