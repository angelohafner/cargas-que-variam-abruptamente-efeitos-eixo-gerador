            <param name="cond" value="true" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1812676181" x="0" y="-12">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="GAS TURBINE - GAST" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1224613123" x="0" y="15">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="Fuel valve | Turbine | Temperature limit | Speed governor" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
      </graphics>
    </Definition>
  </definitions>
