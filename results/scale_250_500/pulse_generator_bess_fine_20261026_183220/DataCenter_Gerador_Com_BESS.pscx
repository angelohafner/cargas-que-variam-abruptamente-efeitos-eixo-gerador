      <svg viewBox="-200 -100 200 100">
        <rect x="-180" y="-54" width="360" height="108" stroke="Black" stroke-width="1" fill-style="Solid" fill-fg="#e1f0f4" />
        <text x="0" y="-12" font-size="14" text-anchor="middle" fill="Black">MEASURED ENERGY AUDIT</text>
        <text x="0" y="15" font-size="11" text-anchor="middle" fill="Black">Terminal energy | Losses | Capacitor | SOC</text>
      </svg>
      <script>
        <segment name="Dsdyn" id="190020002" classid="CoreSegment"><![CDATA[#STORAGE REAL:7
#LOCAL INTEGER K
#LOCAL REAL PBAT
#LOCAL REAL PPRE
#LOCAL REAL PSW
#LOCAL REAL I2
#LOCAL REAL PFILT
#LOCAL REAL PTF
      K=NSTORF
      NSTORF=NSTORF+7
      IF(TIME.LT.DELT*0.5) STORF(K:K+6)=0.0
      PBAT=$VB*$IBat
      PPRE=($VB-$VDc)*$IBat
      I2=$ILA*$ILA+$ILB*$ILB+$ILC*$ILC
      PFILT=0.00001*I2
      PTF=0.0000076176*I2
      PSW=$ICAH*$VCAH+~
~$ICDAH*$VCDAH+~
~$ICAL*$VCAL+~
~$ICDAL*$VCDAL+~
~$ICBH*$VCBH+~
~$ICDBH*$VCDBH+~
~$ICBL*$VCBL+~
~$ICDBL*$VCDBL+~
~$ICCH*$VCCH+~
~$ICDCH*$VCDCH+~
~$ICCL*$VCCL+~
~$ICDCL*$VCDCL
      STORF(K)=STORF(K)+PBAT*DELT
      STORF(K+1)=STORF(K+1)+$PB*DELT
      STORF(K+2)=STORF(K+2)+(PPRE+PSW+PFILT+PTF)*DELT
      STORF(K+3)=STORF(K+3)+($VB+0.00009*$IBat)*$IBat*DELT
      STORF(K+4)=STORF(K+4)+$IBat*DELT
      STORF(K+5)=STORF(K+5)+MAX(PBAT,0.0)*DELT
      STORF(K+6)=STORF(K+6)+MAX(-PBAT,0.0)*DELT
#OUTPUT REAL Pbat_MW {PBAT}
#OUTPUT REAL Ploss_pre_MW {PPRE}
#OUTPUT REAL Ploss_switch_MW {PSW}
#OUTPUT REAL Ploss_filter_MW {PFILT}
#OUTPUT REAL Ploss_transformer_MW {PTF}
#OUTPUT REAL P_LV_MW {$VLA*$ILA+$VLB*$ILB+$VLC*$ILC}
#OUTPUT REAL Ecap_MJ {0.5*1.0*$VDc*$VDc}
#OUTPUT REAL Eind_MJ {0.5*0.000001042476*I2}
#OUTPUT REAL Ebat_MJ {STORF(K)}
#OUTPUT REAL Ebess_MJ {STORF(K+1)}
#OUTPUT REAL Eloss_MJ {STORF(K+2)}
#OUTPUT REAL Echem_MJ {STORF(K+3)}
#OUTPUT REAL Charge_kAs {STORF(K+4)}
#OUTPUT REAL Edis_MJ {STORF(K+5)}
#OUTPUT REAL Echg_MJ {STORF(K+6)}
]]></segment>
      </script>
