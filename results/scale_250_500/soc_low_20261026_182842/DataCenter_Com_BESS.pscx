          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="488760925" x="0" y="-12">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="DATA CENTER CONTROL" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Text" id="1093184012" x="0" y="15">
          <paramlist>
            <param name="color" value="Black" />
            <param name="font_size" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="anchor" value="1" />
            <param name="cond" value="true" />
            <param name="text" value="Load | Smoothing | SOC | PLL | dq | PWM" />
            <param name="lock" value="false" />
            <param name="angle" value="0" />
          </paramlist>
        </Gfx>
