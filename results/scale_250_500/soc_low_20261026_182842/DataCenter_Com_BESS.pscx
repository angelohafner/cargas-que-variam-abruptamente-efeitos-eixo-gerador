    <Definition classid="UserCmpDefn" name="DC_Controller" url="" view="false" instances="0" date="0" crc="14230197" id="190010001">
      <paramlist>
        <param name="Description" value="Data center dispatch, SOC protection, SRF PLL and dq current control" />
      </paramlist>
      <form name="Data center controls" w="600" h="700" splitter="60" commentlines="4">
        <category name="Adjustable controls" visible="true">
          <cond />
          <parameter type="Real" name="BessEnabled" desc="Enable BESS (0/1)" content_type="Constant" min="0" max="1" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pmin" desc="Low load [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>250.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pmax" desc="High load [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>500.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pmid" desc="Final load [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>375.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pstep1" desc="First step load [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>458.3333333333333</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Pstep2" desc="Second step load [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>291.6666666666667</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T1" desc="First step time [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T2" desc="Second step time [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>4</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T3" desc="First pulse train start [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>6</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T4" desc="High plateau start [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>10</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T5" desc="Low plateau start [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>15</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T6" desc="Second pulse train start [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="T7" desc="Final plateau start [s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>25</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Period1" desc="First pulse train period [s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.4</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Period2" desc="Second pulse train period [s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Duty1" desc="First pulse duty fraction" content_type="Constant" min="0" max="1" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Duty2" desc="Second pulse duty fraction" content_type="Constant" min="0" max="1" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Transition" desc="Load transition [s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.02</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="TauSmooth" desc="Smoothing time [s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RampMax" desc="Grid reference ramp [MW/s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>25</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="PmaxBess" desc="BESS power limit [MW]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>250</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="SOCmin" desc="Minimum SOC [%]" content_type="Constant" min="0" max="100" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="SOCmax" desc="Maximum SOC [%]" content_type="Constant" min="0" max="100" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>80</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="SOCref" desc="SOC target [%]" content_type="Constant" min="0" max="100" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>50</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="SOChyst" desc="SOC hysteresis [% points]" content_type="Constant" min="0" max="100" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.05</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RecoveryGain" desc="SOC recovery gain [MW/percent]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RecoveryMax" desc="SOC recovery maximum [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>25</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RecoveryTau" desc="SOC recovery time [s]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="RecoveryDead" desc="SOC deadband [% points]" content_type="Constant" min="0" max="100" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fgrid" desc="Network frequency [Hz]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>60</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Fsw" desc="PWM frequency [Hz]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2000</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Lf" desc="Coupling inductance [H]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>8.000000000000001e-07</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Rf" desc="Coupling resistance [ohm]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1e-05</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KpI" desc="Current PI proportional gain [ohm]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0008</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KiI" desc="Current PI integral gain [ohm/s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.4</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Imax" desc="dq peak current limit [kA]" content_type="Constant" min="1E-9" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>310.0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="Mmax" desc="Maximum modulation" content_type="Constant" min="0" max="1" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.98</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KpPLL" desc="PLL proportional [1/s]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>50</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="KiPLL" desc="PLL integral [1/s2]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>900</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="TestMode" desc="0 nominal; 1 SOC low; 2 SOC high; 3 power reversal" content_type="Constant" min="0" max="3" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="TestPower" desc="Protection test power [MW]" content_type="Constant" min="0" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>150</value>
            <cond type="Enable" />
            <help />
          </parameter>
        </category>
        <category name="Measured inputs" visible="true">
          <cond />
