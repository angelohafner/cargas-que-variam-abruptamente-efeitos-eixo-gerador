    </Definition>
    <Definition classid="UserCmpDefn" name="EnergyAudit" url="" view="false" instances="0" date="0" crc="103539273" id="190020001">
      <paramlist>
        <param name="Description" value="Independent terminal power, losses, coulomb and energy audit" />
      </paramlist>
      <form name="Measured energy audit" w="600" h="700" splitter="60" commentlines="4">
        <category name="Measured inputs" visible="true">
          <cond />
          <parameter type="Real" name="VB" desc="VB" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Vbat_kV</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="IBat" desc="IBat" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Ibat_kA</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="VDc" desc="VDc" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Vdc_kV</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="PB" desc="PB" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>Pbess_MW</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="ILA" desc="ILA" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>ILA_kA</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="ILB" desc="ILB" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>ILB_kA</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="ILC" desc="ILC" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>ILC_kA</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="VLA" desc="VLA" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>VLA_kV</value>
            <cond type="Enable" />
            <help />
          </parameter>
          <parameter type="Real" name="VLB" desc="VLB" content_type="Variable" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>VLB_kV</value>
            <cond type="Enable" />
